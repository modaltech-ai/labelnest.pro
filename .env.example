# Where the waitlist form POSTs {email, label, source} as JSON.
# Works with Formspree, Buttondown, a Cloudflare Worker, or any endpoint
# that accepts a JSON POST and returns 2xx.
#
# If this is left unset, the form falls back to a mailto: handoff and
# tells the visitor so — it never pretends a signup succeeded.
VITE_WAITLIST_ENDPOINT=

# Address used for the mailto: fallback and the footer contact link.
VITE_CONTACT_EMAIL=hello@labelnest.pro
