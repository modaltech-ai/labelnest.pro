# Where the waitlist form POSTs {email, label, source} as JSON.
#
# Defaults to the same-origin PHP endpoint shipped in public/api/waitlist.php,
# which stores signups on the server and emails a notification. Only set this
# if you want to post somewhere else instead (Formspree, Buttondown, a Worker).
VITE_WAITLIST_ENDPOINT=

# Address used for the footer contact link and the form's mail fallback.
VITE_CONTACT_EMAIL=hello@labelnest.pro
